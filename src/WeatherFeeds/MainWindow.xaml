<Window x:Class="WeatherFeeds.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="WeatherFeeds – Memphis DMA"
        Icon="Assets/WeatherFeeds.ico"
        Width="1400" Height="900" MinWidth="800" MinHeight="500"
        Background="#0d1117">
    <Grid>
        <wv2:WebView2 x:Name="Web" DefaultBackgroundColor="#0d1117" />
        <TextBlock x:Name="ErrorText" Visibility="Collapsed" Foreground="#f85149" FontSize="16"
                   TextWrapping="Wrap" Margin="40" VerticalAlignment="Center" HorizontalAlignment="Center" />
    </Grid>
</Window>
