<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <!-- WinForms is used only for the system-tray icon (NotifyIcon). -->
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationIcon>Assets\WeatherFeeds.ico</ApplicationIcon>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>WeatherFeeds</AssemblyName>
    <RootNamespace>WeatherFeeds</RootNamespace>
    <!-- The one place the version is set: shown in the title bar, tray, dashboard headers, Settings and User-Agent. -->
    <Version>1.8.0</Version>
    <Product>WeatherFeeds</Product>
    <Description>Memphis DMA weather dashboard powered by api.weather.gov</Description>
  </PropertyGroup>

  <ItemGroup>
    <!-- Keep WPF types unambiguous; WinForms/Drawing are referenced explicitly where needed. -->
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
    <Resource Include="Assets\WeatherFeeds.ico" />
  </ItemGroup>

  <ItemGroup>
    <!-- The dashboard UI is embedded in the exe and extracted to %LOCALAPPDATA%\WeatherFeeds\web at startup. -->
    <EmbeddedResource Include="wwwroot\**\*" LogicalName="wwwroot/%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4314.35" />
  </ItemGroup>

</Project>
